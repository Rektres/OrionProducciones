# DATABASE
DATABASE_URL=postgresql://postgres:SECURE_PASSWORD@postgres:5432/orion
POSTGRES_PASSWORD=SECURE_PASSWORD

# DJANGO
DJANGO_SECRET_KEY=LONG_RANDOM_SECRET_KEY_CHANGE_IN_PROD
DEBUG=False
# El postgres de docker-compose no tiene SSL habilitado (red interna Docker)
DB_SSL_REQUIRE=False

# IP pública del servidor (sin dominio todavía)
SERVER_IP=203.0.113.10

# HOSTS / CORS (acceso vía IP, sin dominio)
ALLOWED_ORIGINS=http://203.0.113.10

# Nota: VITE_API_URL ya está fijado en frontend-vue/.env.production como
# ruta relativa (/api), por lo que funciona con cualquier IP o dominio
# sin necesidad de rebuild. No hace falta definirlo aquí.
