# URL del BFF (Express). Local: http://localhost:3001/api ; prod: /api (ruta relativa,
# la resuelve Nginx, asi que el mismo build sirve para cualquier IP o dominio)
VITE_API_URL=http://localhost:3001/api
VITE_WHATSAPP_NUMBER=56944830378
# Base path del SPA. Se sirve desde la raiz.
VITE_BASE=/
# Redes y contacto mostrados en el footer. Si el email queda vacio no se muestra.
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_DIRECCION=Santiago, Chile

# Analitica opcional. Vacio = no se carga ningun script ni cookie de terceros.
# plausible (sin cookies, no requiere banner) | ga4 (con cookies, pide consentimiento)
VITE_ANALYTICS_PROVIDER=
# Dominio para plausible (orion.cl) o Measurement ID para GA4 (G-XXXXXXX)
VITE_ANALYTICS_ID=
VITE_PLAUSIBLE_HOST=https://plausible.io
